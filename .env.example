# TAAR — environment
# Copy to .env.local for local work. The same values live in the Vercel project
# settings (for the API + UI) and in GitHub Actions repository secrets (for the
# scheduled tick, which never touches Vercel).

# MongoDB Atlas M0 connection string. The app always uses the `taar` database
# regardless of the path segment here.
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/taar?retryWrites=true&w=majority"

# Primary LLM — Groq, llama-3.3-70b-versatile. Free tier.
GROQ_API_KEY=""

# Fallback LLM — Google AI Studio (Gemini flash). Free tier.
GEMINI_API_KEY=""

# Breeth memory API. Optional: if absent or failing, TAAR degrades to Mongo-only
# dedupe and keeps publishing.
BREETH_API_KEY=""

# Bearer token guarding POST /api/agent/tick, the backup scheduler entrypoint.
CRON_SECRET=""

# Public origin of the deployment. Used by scripts/verify-feed.ts and by the UI
# for absolute URLs. No trailing slash.
NEXT_PUBLIC_APP_URL="https://taar.vercel.app"
